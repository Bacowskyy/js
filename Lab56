import java.util.Arrays;
import java.util.Locale;

public class Temperatury {
    public static void main(String[] args) {
        // 1. Deklaracja tablicy i wypisanie jej
        int[] temperatury = {12, 15, 9, 18, 21, 17, 14};
        System.out.println("Temperatury: " + Arrays.toString(temperatury));

        // 2. Wyznaczenie najniższej, najwyższej temperatury oraz sumy w jednej pętli
        int najnizsza = temperatury[0];
        int najwyzsza = temperatury[0];
        int suma = 0;

        for (int t : temperatury) {
            if (t < najnizsza) {
                najnizsza = t;
            }
            if (t > najwyzsza) {
                najwyzsza = t;
            }
            suma += t;
        }

        System.out.println("Najniższa: " + najnizsza + ", najwyższa: " + najwyzsza);

        // Obliczenie średniej typu double i wypisanie z jednym miejscem po przecinku (zgodnie z polską lokalizacją)
        double srednia = (double) suma / temperatury.length;
        System.out.printf(new Locale("pl", "PL"), "Średnia: %.1f%n", srednia);

        // 3. Kopiowanie metodą clone(), sortowanie i wypisanie
        int[] posortowane = temperatury.clone();
        Arrays.sort(posortowane);
        System.out.println("Posortowane: " + Arrays.toString(posortowane));

        // 4. Utworzenie tablicy z trzema najwyższymi temperaturami metodą Arrays.copyOfRange
        int[] trzyNajwyzsze = Arrays.copyOfRange(posortowane, posortowane.length - 3, posortowane.length);
        System.out.println("Trzy najwyższe: " + Arrays.toString(trzyNajwyzsze));

        // 5. Wypisanie oryginalnej tablicy (zawartość nie zmieniła się)
        System.out.println("Oryginał: " + Arrays.toString(temperatury));
    }
}
