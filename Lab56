class NiepoprawnaOcenaException extends Exception {
    public NiepoprawnaOcenaException(String message) {
        super(message);
    }
}

public class Oceny {
    
    public static void sprawdzOcene(int ocena) throws NiepoprawnaOcenaException {
        if (ocena < 2 || ocena > 5) {
            throw new NiepoprawnaOcenaException("ocena spoza zakresu 2-5: " + ocena);
        }
    }

    public static void main(String[] args) {
        int[] tablicaOcen = {4, 7, 3, 1};
        int poprawne = 0;

        
        int sprawdzone = 0;

        for (int ocena : tablicaOcen) {
            try {
                sprawdzOcene(ocena);
                poprawne++; // Zliczanie poprawnych ocen w bloku try
                System.*out*.println("Ocena " + ocena + ": poprawna");
            } catch (NiepoprawnaOcenaException e) {
                System.*out*.println("Ocena " + ocena + ": błąd, " + e.getMessage());
            } finally {
                sprawdzone++; // Zliczanie wszystkich sprawdzonych ocen w bloku finally
            }
        }

        System.*out*.println("Sprawdzono ocen: " + sprawdzone + ", poprawnych: " + poprawne);
    }
}

