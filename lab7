//Pudelko.java


public class Pudelko<T> {

    private T zawartosc;

    public Pudelko(T zawartosc) {
        this.zawartosc = zawartosc;
    }

    public T getZawartosc() {
        return zawartosc;
    }

    public void setZawartosc(T zawartosc) {
        this.zawartosc = zawartosc;
    }

    @Override
    public String toString() {
        return "Pudełko[" + zawartosc + "]";
    }
}


//TestPudelka.java


public class TestPudelka {

    public static void main(String[] args) {

        Pudelko<String> napis = new Pudelko<>("Java");
        Pudelko<Integer> liczba = new Pudelko<>(25);
        var rzeczywista = new Pudelko<>(3.14);

        System.out.println(napis);
        System.out.println(liczba);
        System.out.println(rzeczywista);

        liczba.setZawartosc(liczba.getZawartosc() + 5);

        System.out.println("Zawartość + 5 = " + liczba.getZawartosc());

        napis.setZawartosc("Java 25");

        System.out.println("Po zmianie: " + napis);
        System.out.println("Długość napisu: " + napis.getZawartosc().length());

        // liczba.setZawartosc("tekst");
    }
}



